<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Shop</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Styles -->
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/products.css">
    <link rel="stylesheet" href="/css/common.css">

    <!-- Scripts -->
    <script> const products = <%- JSON.stringify(products); %> </script> <!-- shows as "expression expired" but should work fine still -->
    <script src="/js/products.js" defer></script>
</head>
<body>

    <%- include('./partials/nav.ejs') %>

    <main>
        <div id="filters">
            <select id="filter-category" class="filter">
                <option value="">All Categories</option>
                <option value="hand tools">Hand Tools</option>
                <option value="watering equipment">Watering Equipment</option>
                <option value="garden equipment">Garden Equipment</option>
            </select>
            <input type="number" id="filter-price" class="filter" placeholder="Min price" min="0" />
        </div>

        <section id="products-grid">
            <!-- load products in -->
        </section>
    </main>

    <%- include('./partials/footer.ejs') %>

</body>
</html>
